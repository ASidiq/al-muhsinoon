---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import MagazineReader from '../../components/MagazineReader.astro';
import { Image } from 'astro:assets';
import {
  AWARDEES_PAGE,
  AWARDS,
  FELICITATIONS,
  GRADUANDS,
  MAGAZINE_PDF,
  SHOW_FROM_THE_DAY,
} from '../../data/anniversary';
import { graduandPhoto, magazinePage } from '../../lib/anniversary-assets';

const eyebrow = 'font-body text-[12px] font-bold uppercase tracking-[0.2em] text-gold-deep';
const h2 = 'font-display text-[32px] font-medium leading-[1.12] tracking-[-0.02em] text-maroon sm:text-[38px]';
const coverShadow =
  'shadow-[0_1px_2px_rgba(42,21,24,0.1),0_12px_30px_-8px_rgba(94,26,36,0.35),0_40px_80px_-24px_rgba(94,26,36,0.35)]';
const magazineLink =
  'focus-ring font-body text-[14px] font-semibold text-maroon transition-colors duration-200 hover:text-maroon-dark active:text-ink';

// Placeholder tiles for "From the day" — replace with real media before turning on SHOW_FROM_THE_DAY.
const fromTheDay = ['video · highlights from the hall', 'photo · graduands', 'photo · recitation', 'photo · the Amir', 'photo · the community'];
---

<Layout
  title="10th Anniversary & First Walimatul Qur’an · Al-Muhsinoon"
  description="Ten years of Al-Muhsinoon, and our first Walimatul Qur’an: read the 32-page anniversary magazine, meet the 2026 graduands, and see the anniversary awardees. Saturday 12 September 2026, The Memory Hall, Bolton."
>
  <Nav />
  <main>
    <!-- Hero -->
    <section
      class="relative overflow-hidden"
      style="background:radial-gradient(680px 420px at 88% -10%, rgba(229,148,107,0.30), transparent 65%), radial-gradient(520px 380px at 0% 110%, rgba(196,154,69,0.22), transparent 60%), linear-gradient(180deg,#FBF3E7,#F6EBD8)"
    >
      <div class="mx-auto max-w-6xl px-5 pb-20 pt-7 sm:px-8">
        <nav aria-label="Breadcrumb">
          <ol class="flex gap-2 font-body text-[13px] text-ink/55">
            <li><a href="/" class="focus-ring transition-colors duration-200 hover:text-maroon">Home</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" class="text-maroon">10th Anniversary</li>
          </ol>
        </nav>

        <div class="mt-11 flex flex-wrap items-center gap-14">
          <div class="min-w-0 flex-[1_1_460px]">
            <p class={`${eyebrow} text-[12.5px]`}>Special Edition · Saturday 12 September 2026</p>
            <h1
              class="mt-[18px] text-balance font-display text-[clamp(40px,5.4vw,64px)] font-medium leading-[1.03] tracking-[-0.03em] text-maroon"
            >
              Ten years of Al-Muhsinoon, and our first Walimatul Qur’an.
            </h1>
            <p class="mt-[22px] font-display text-[22px] italic text-gold-deep">
              ‘A decade of service to the community and humanity’
            </p>
            <p class="mt-[18px] max-w-[52ch] text-pretty font-body text-[17px] leading-[1.75] text-ink/72">
              On 12 September the community gathered at The Memory Hall, Bolton, to mark ten years of the centre and to
              honour our first cohort of Qur’an graduands. The anniversary magazine made for the day is below.
            </p>
            <div class="mt-[30px] flex flex-wrap gap-3">
              <a
                href="#magazine"
                class="focus-ring rounded-full bg-maroon px-6 py-3.5 font-body text-[15px] font-semibold text-cream shadow-[0_4px_14px_-4px_rgba(94,26,36,0.4)] transition-transform duration-200 ease-out hover:-translate-y-0.5 active:translate-y-0"
              >
                Read the magazine
              </a>
              <a
                href={MAGAZINE_PDF}
                download
                class="focus-ring rounded-full border border-maroon/25 px-6 py-3.5 font-body text-[15px] font-semibold text-maroon transition-colors duration-200 hover:bg-maroon/5 active:bg-maroon/10"
              >
                Download PDF · 20 MB
              </a>
            </div>
          </div>

          <div class="flex flex-[0_1_400px] justify-center">
            <div class="relative w-[340px] max-w-[80%] sm:max-w-full">
              <Image
                src={magazinePage(6)}
                alt=""
                width={600}
                class="absolute left-[26%] top-[6%] w-[88%] rotate-6 rounded-[3px] shadow-[0_20px_48px_-16px_rgba(94,26,36,0.35)]"
              />
              <Image
                src={magazinePage(1)}
                alt="Anniversary magazine cover"
                width={680}
                loading="eager"
                class={`relative block w-full -rotate-3 rounded-[3px] ${coverShadow}`}
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <MagazineReader />

    <!-- Graduands -->
    <section class="mx-auto max-w-6xl px-5 py-20 sm:px-8">
      <div class="flex flex-wrap gap-14">
        <div class="flex-[0_1_300px]">
          <p class={eyebrow}>First Walimatul Qur’an</p>
          <h2 class={`mt-3 ${h2}`}>The 2026 graduands</h2>
          <p class="mt-3.5 font-body text-[16px] leading-[1.7] text-ink/70">
            Nine students of the madrasa, honoured before the community. Taught under Imam Munir Ajikanle Hussein, Amir
            and Founder.
          </p>
        </div>
        <ul class="grid flex-[1_1_560px] grid-cols-[repeat(auto-fill,minmax(220px,1fr))] gap-x-6 gap-y-7">
          {GRADUANDS.map((g) => (
            <li class="flex items-center gap-4">
              <div class="h-[84px] w-[84px] flex-none rounded-full bg-[linear-gradient(135deg,#C49A45,#A57E2E)] p-[3px]">
                <Image
                  src={graduandPhoto(g.slug)}
                  alt={g.name}
                  width={168}
                  height={168}
                  class="block h-full w-full rounded-full border-2 border-cream object-cover"
                />
              </div>
              <span class="font-display text-[19px] leading-[1.25] text-maroon">{g.name}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Awardees -->
    <section id="awardees" class="border-t border-maroon/10">
      <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class={eyebrow}>Anniversary honours</p>
            <h2 class={`mt-3 ${h2}`}>Awardees</h2>
            <p class="mt-3.5 max-w-[56ch] font-body text-[16px] leading-[1.7] text-ink/70">
              Recognising those whose service, support and leadership have carried Al-Muhsinoon through its first
              decade.
            </p>
          </div>
          <a href="#magazine" data-open-page={AWARDEES_PAGE} class={`py-2 ${magazineLink}`}>
            View in magazine <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="mt-11 columns-[3_280px] gap-12">
          {AWARDS.map((award) => (
            <div class="break-inside-avoid border-t border-gold pb-6 pt-5">
              <h3 class="font-body text-[11.5px] font-bold uppercase leading-[1.5] tracking-[0.16em] text-gold-deep">
                {award.title}
              </h3>
              <ul class="mt-3 flex flex-col gap-1.5">
                {award.names.map((name) => (
                  <li class="font-display text-[18px] leading-[1.35] text-ink">{name}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Felicitations -->
    <section class="bg-cream-warm">
      <div class="mx-auto max-w-6xl px-5 py-[72px] sm:px-8">
        <p class={eyebrow}>Felicitations</p>
        <h2 class="mt-2.5 font-display text-[30px] font-medium tracking-[-0.02em] text-maroon sm:text-[34px]">
          Messages from our friends
        </h2>
        <div class="mt-8 grid grid-cols-[repeat(auto-fit,minmax(min(440px,100%),1fr))] gap-6">
          {FELICITATIONS.map((f) => (
            <a
              href="#magazine"
              data-open-page={f.page}
              class="focus-ring group flex gap-5 rounded-xl bg-cream p-5 shadow-soft transition-[box-shadow,transform] duration-300 ease-out hover:-translate-y-0.5 hover:shadow-[0_8px_24px_-8px_rgba(94,26,36,0.28)] active:translate-y-0 sm:gap-6 sm:p-7"
            >
              <Image
                src={magazinePage(f.page)}
                alt={`Felicitations from ${f.org}`}
                width={280}
                class="block h-[141px] w-[100px] flex-none rounded object-cover sm:h-[198px] sm:w-[140px]"
              />
              <div>
                <p class="font-body text-[11px] font-bold uppercase tracking-[0.16em] text-gold-deep">{f.org}</p>
                <blockquote class="mt-3 font-display text-[18px] leading-[1.45] text-ink sm:text-[20px]">
                  “{f.quote}”
                </blockquote>
                <p class="mt-3.5 font-body text-[13px] font-semibold text-maroon">
                  View in magazine <span aria-hidden="true">→</span>
                </p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    {
      SHOW_FROM_THE_DAY && (
        <!-- From the day -->
        <section class="mx-auto max-w-6xl px-5 pb-[88px] pt-[72px] sm:px-8">
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <h2 class="font-display text-[30px] font-medium text-maroon">From the day</h2>
            <p class="font-body text-[14px] text-ink/55">Photos and video coming soon</p>
          </div>
          <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-[2fr_1fr_1fr] sm:grid-rows-[200px_200px]">
            {fromTheDay.map((label, i) => (
              <div
                class:list={[
                  'flex min-h-[140px] items-center justify-center rounded-[10px] bg-[repeating-linear-gradient(135deg,#F1E4CC_0_12px,#EADCC3_12px_24px)] font-mono text-[13px] text-ink/50',
                  i === 0 && 'col-span-2 sm:col-span-1 sm:row-span-2',
                ]}
              >
                {label}
              </div>
            ))}
          </div>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>
