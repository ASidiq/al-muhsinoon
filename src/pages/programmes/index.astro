---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { ProgrammesExplorer } from '../../components/ProgrammesExplorer';
---

<Layout
  title="Our Programmes — Al-Muhsinoon Islamic Cultural Centre"
  description="Jummah Service, Madrasa, Eid Prayer, lectures and Ramadan Bayaan, Minding & Mending, zakat & sadaqah, Aqeeqah and Nikkah — every programme Al-Muhsinoon runs for the Manchester community."
>
  <Nav />
  <main>
    <section class="py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-6 sm:px-8">
        <div class="max-w-xl">
          <p class="font-body text-[12.5px] font-bold uppercase tracking-[0.2em] text-gold-deep">What happens here</p>
          <h1 class="mt-4 font-display text-[2.1rem] font-medium leading-[1.12] tracking-[-0.01em] text-maroon sm:text-[2.5rem]">
            Every programme, in one place.
          </h1>
          <p class="mt-5 font-body text-[15.5px] leading-[1.75] text-ink/65">
            Select a programme below to read more and step through photos from our archive.
          </p>
        </div>

        <div class="mt-14">
          <ProgrammesExplorer client:load />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
