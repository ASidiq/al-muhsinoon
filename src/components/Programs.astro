---
import { programmes } from '../data/programmes';
---

<section id="programs" class="py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-6 sm:px-8">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)] lg:gap-16">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="font-body text-[12.5px] font-bold uppercase tracking-[0.2em] text-gold-deep">What happens here</p>
        <h2 class="mt-4 font-display text-[2.1rem] font-medium leading-[1.12] tracking-[-0.01em] text-maroon sm:text-[2.5rem]">
          Eight programmes, one community.
        </h2>
        <p class="mt-5 max-w-md font-body text-[15.5px] leading-[1.75] text-ink/65">
          From Friday prayers to family days out, every programme is run by volunteers from the community, for the community — and every one of them is free to attend.
        </p>
        <a
          href="/programmes"
          class="focus-ring mt-6 inline-flex items-center gap-2 font-body text-[14.5px] font-semibold text-maroon transition-[gap,color] duration-200 ease-out hover:gap-3 hover:text-maroon-dark"
        >
          See every programme
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        {programmes.map((programme) => {
          const Icon = programme.icon;
          const heroImage = programme.gallery[0];

          return (
            <a
              href={`/programmes#${programme.slug}`}
              class="focus-ring group flex flex-col overflow-hidden rounded-xl border border-maroon/10 bg-white shadow-soft transition-[transform,box-shadow] duration-300 ease-out hover:-translate-y-1 hover:shadow-lift"
            >
              <div class="relative aspect-[4/3] w-full overflow-hidden bg-maroon-dark">
                {heroImage ? (
                  <>
                    <img
                      src={heroImage.src}
                      alt=""
                      aria-hidden="true"
                      loading="lazy"
                      decoding="async"
                      class="absolute inset-0 h-full w-full scale-110 object-cover blur-2xl brightness-[0.55]"
                    />
                    <img
                      src={heroImage.src}
                      alt={heroImage.alt}
                      loading="lazy"
                      decoding="async"
                      class="relative h-full w-full object-contain transition-transform duration-500 ease-out group-hover:scale-105"
                    />
                  </>
                ) : (
                  <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-maroon to-maroon-dark">
                    <Icon className="h-9 w-9 text-gold" aria-hidden="true" />
                  </div>
                )}
                <div
                  class="absolute inset-0 bg-gradient-to-t from-maroon-dark/80 via-maroon-dark/10 to-transparent mix-blend-multiply"
                  aria-hidden="true"
                />
              </div>
              <div class="flex flex-1 flex-col gap-2 p-5">
                <h3 class="font-display text-[1.05rem] font-medium text-maroon">{programme.title}</h3>
                <p class="font-body text-[13.5px] leading-[1.6] text-ink/65">{programme.summary}</p>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </div>
</section>
