---
const programs = [
  {
    letter: 'ا',
    title: 'Daily & Jumu‘ah Prayers',
    body: 'Congregational prayers held five times a day, with a Friday khutbah open to the whole community.',
  },
  {
    letter: 'ب',
    title: 'Qur’an & Arabic School',
    body: 'Weekend classes for children and adults, from first letters and tajweed through to confident reading.',
  },
  {
    letter: 'ج',
    title: 'Zakat & Sadaqah Support',
    body: 'Zakat collected and distributed within the local community — food parcels and emergency hardship grants.',
  },
  {
    letter: 'د',
    title: 'Community Welfare',
    body: 'Befriending for elders, guidance for new Muslims, and support with funeral (janazah) arrangements.',
  },
  {
    letter: 'ه',
    title: 'Youth & Family',
    body: 'Halaqahs, school holiday clubs, and guidance for marriage (nikah) — for every stage of family life.',
  },
];
---

<section id="programs" class="py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-6 sm:px-8">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)] lg:gap-16">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="font-body text-[12.5px] font-bold uppercase tracking-[0.2em] text-gold-deep">What happens here</p>
        <h2 class="mt-4 font-display text-[2.1rem] font-medium leading-[1.12] tracking-[-0.01em] text-maroon sm:text-[2.5rem]">
          Five days a week, the centre is in use.
        </h2>
        <p class="mt-5 max-w-md font-body text-[15.5px] leading-[1.75] text-ink/65">
          Every programme is run by volunteers from the community, for the community — and every one of them is free to attend.
        </p>
      </div>

      <ul class="divide-y divide-maroon/10 border-y border-maroon/10">
        {programs.map((program) => (
          <li class="group flex gap-6 py-7 sm:gap-9">
            <span
              class="font-arabic flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-gold/30 bg-sand/15 text-[1.4rem] text-maroon transition-colors duration-300 group-hover:border-gold group-hover:bg-gold/15"
              aria-hidden="true"
            >
              {program.letter}
            </span>
            <div>
              <h3 class="font-display text-[1.25rem] font-medium text-maroon">{program.title}</h3>
              <p class="mt-2 max-w-lg font-body text-[15px] leading-[1.7] text-ink/65">{program.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
