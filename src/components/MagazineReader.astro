---
import { getImage } from 'astro:assets';
import { MAGAZINE_PAGE_COUNT, MAGAZINE_PDF, pageAlt } from '../data/anniversary';
import { magazinePage } from '../lib/anniversary-assets';

// Every page is resolved to its fingerprinted URL here and handed to the client script
// on a data attribute, since the script can swap to any page but can't run the image
// pipeline itself. Thumbnails are built small (96px tall at 2x) so the strip stays light.
const pages = await Promise.all(
  Array.from({ length: MAGAZINE_PAGE_COUNT }, async (_, i) => {
    const n = i + 1;
    const src = magazinePage(n);
    const [full, thumb] = await Promise.all([
      getImage({ src, format: 'webp' }),
      getImage({ src, format: 'webp', height: 192 }),
    ]);
    return { n, alt: pageAlt(n), src: full.src, thumb: thumb.src, width: src.width, height: src.height };
  })
);

const first = pages[0];
const navButton =
  'focus-ring flex h-10 w-10 flex-none items-center justify-center rounded-full border border-cream/25 font-display text-[22px] leading-none text-cream transition-[background-color,transform] duration-200 ease-out hover:bg-cream/10 active:scale-95 sm:h-12 sm:w-12';
---

<section id="magazine" class="scroll-mt-[60px] bg-maroon-dark text-cream">
  <div class="mx-auto max-w-6xl px-5 py-[72px] sm:px-8">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="font-body text-[12px] font-bold uppercase tracking-[0.2em] text-[#D9B45F]">The anniversary magazine</p>
        <h2 class="mt-2.5 font-display text-[32px] font-medium tracking-[-0.02em] sm:text-[38px]">Turn the pages</h2>
      </div>
      <div class="flex items-center gap-4 font-body text-[14px] text-cream/65">
        <span>{MAGAZINE_PAGE_COUNT} pages</span>
        <a
          href={MAGAZINE_PDF}
          download
          class="focus-ring font-semibold text-[#D9B45F] transition-colors duration-200 hover:text-sand active:text-gold"
        >
          Download PDF <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div
      id="magazine-reader"
      data-pages={JSON.stringify(pages.map(({ src, alt }) => ({ src, alt })))}
      role="region"
      aria-roledescription="page viewer"
      aria-label="Anniversary magazine"
    >
      <div class="mt-8 flex items-center justify-center gap-3 rounded-[14px] bg-[#2A0C11] px-3 py-7 sm:gap-5 sm:px-5">
        <button type="button" data-reader-prev aria-label="Previous page" class={navButton}>‹</button>
        <div class="flex min-w-0 flex-1 justify-center">
          <img
            data-reader-page
            src={first.src}
            alt={first.alt}
            width={first.width}
            height={first.height}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="block h-auto max-h-[min(72vh,680px)] w-auto max-w-full object-contain shadow-[0_30px_60px_-20px_rgba(0,0,0,0.6)]"
          />
        </div>
        <button type="button" data-reader-next aria-label="Next page" class={navButton}>›</button>
      </div>

      <div class="mt-4 flex items-center justify-between gap-4 font-body text-[14px] text-cream/70">
        <span data-reader-counter aria-live="polite">Page 1 of {MAGAZINE_PAGE_COUNT}</span>
        <span class="hidden text-cream/45 sm:inline">Use ← → keys to turn</span>
      </div>

      <div data-reader-strip class="relative mt-4 flex gap-3 overflow-x-auto px-1 pb-2.5 pt-1.5">
        {pages.map((p, i) => (
          <button
            type="button"
            data-reader-thumb={i}
            data-active={i === 0 ? '' : undefined}
            aria-current={i === 0 ? 'page' : undefined}
            aria-label={p.alt}
            class="focus-ring group flex flex-none cursor-pointer flex-col items-center gap-1.5"
          >
            <img
              src={p.thumb}
              alt=""
              loading="lazy"
              decoding="async"
              width={Math.round((96 * p.width) / p.height)}
              height={96}
              class="block h-24 w-auto rounded-[2px] opacity-55 transition-opacity duration-200 group-hover:opacity-100 group-data-[active]:opacity-100 group-data-[active]:outline-2 group-data-[active]:outline-offset-2 group-data-[active]:outline-[#D9B45F] group-data-[active]:outline-solid"
            />
            <span class="font-body text-[11px] text-cream/55">{p.n}</span>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { wrapPage } from '../data/anniversary';

  const reader = document.getElementById('magazine-reader');
  const section = document.getElementById('magazine');

  if (reader && section) {
    const pages: { src: string; alt: string }[] = JSON.parse(reader.dataset.pages ?? '[]');
    const pageImg = reader.querySelector<HTMLImageElement>('[data-reader-page]')!;
    const counter = reader.querySelector<HTMLElement>('[data-reader-counter]')!;
    const strip = reader.querySelector<HTMLElement>('[data-reader-strip]')!;
    const thumbs = [...reader.querySelectorAll<HTMLButtonElement>('[data-reader-thumb]')];
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const behavior = (): ScrollBehavior => (reduceMotion.matches ? 'auto' : 'smooth');

    let current = 0;

    const preload = (i: number) => {
      const img = new Image();
      img.src = pages[wrapPage(i, pages.length)].src;
    };

    function go(index: number) {
      current = wrapPage(index, pages.length);
      const page = pages[current];
      pageImg.src = page.src;
      pageImg.alt = page.alt;
      counter.textContent = `Page ${current + 1} of ${pages.length}`;

      thumbs.forEach((t, i) => {
        const active = i === current;
        t.toggleAttribute('data-active', active);
        if (active) t.setAttribute('aria-current', 'page');
        else t.removeAttribute('aria-current');
      });

      // Keep the active thumbnail centred in the strip.
      const thumb = thumbs[current];
      strip.scrollTo({ left: thumb.offsetLeft - strip.clientWidth / 2 + thumb.clientWidth / 2, behavior: behavior() });

      preload(current + 1);
    }

    /** Jump to page `n` (1-based); with `scroll`, bring the reader into view below the sticky nav. */
    function openPage(n: number, { scroll = false } = {}) {
      go(n - 1);
      if (scroll) {
        const top = section!.getBoundingClientRect().top + window.scrollY - 60;
        window.scrollTo({ top, behavior: behavior() });
      }
    }

    reader.querySelector('[data-reader-prev]')!.addEventListener('click', () => go(current - 1));
    reader.querySelector('[data-reader-next]')!.addEventListener('click', () => go(current + 1));
    thumbs.forEach((t, i) => t.addEventListener('click', () => go(i)));

    window.addEventListener('keydown', (e) => {
      if (e.altKey || e.ctrlKey || e.metaKey) return;
      const tag = (document.activeElement as HTMLElement | null)?.tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA') return;
      if (e.key === 'ArrowRight') go(current + 1);
      else if (e.key === 'ArrowLeft') go(current - 1);
    });

    // Felicitation cards and "View in magazine" links elsewhere on the page. They are
    // plain #magazine anchors, so they still reach the reader without this script.
    document.querySelectorAll<HTMLAnchorElement>('a[data-open-page]').forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        openPage(Number(link.dataset.openPage), { scroll: true });
      });
    });

    preload(1);
  }
</script>
