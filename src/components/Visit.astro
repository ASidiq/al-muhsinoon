---
import StarDivider from './StarDivider.astro';
---

<section id="visit" class="py-20 sm:py-28">
  <div class="mx-auto max-w-4xl px-6 text-center sm:px-8">
    <p class="font-body text-[12.5px] font-bold uppercase tracking-[0.2em] text-gold-deep">Visit us</p>
    <h2 class="mt-4 font-display text-[2.1rem] font-medium leading-[1.12] tracking-[-0.01em] text-maroon sm:text-[2.5rem]">
      Manchester, United Kingdom
    </h2>
    <p class="mx-auto mt-5 max-w-lg font-body text-[15.5px] leading-[1.75] text-ink/65">
      Our doors are open to anyone who wants to pray, ask questions, or simply visit — no appointment needed.
    </p>

    <StarDivider class="my-10" />

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="https://www.google.com/maps/search/?api=1&query=Al-Muhsinoon+Islamic+Cultural+Centre+Manchester"
        target="_blank"
        rel="noopener noreferrer"
        class="focus-ring rounded-full bg-maroon px-7 py-3.5 font-body text-[15px] font-semibold text-cream shadow-soft transition-[transform,box-shadow] duration-200 ease-out hover:-translate-y-0.5 hover:shadow-lift active:translate-y-0"
      >
        Get directions
      </a>
      <a
        href="mailto:hello@almuhsinoon.org"
        class="focus-ring inline-flex items-center gap-2 rounded-full border border-maroon/25 px-7 py-3.5 font-body text-[15px] font-semibold text-maroon transition-colors duration-200 hover:border-maroon hover:bg-maroon/5"
      >
        Email the centre
      </a>
    </div>

    <p class="mt-8 font-body text-[13.5px] text-ink/50">
      Follow along on
      <a href="https://twitter.com/Al_muhsinoon" target="_blank" rel="noopener noreferrer" class="focus-ring font-semibold text-maroon underline-offset-2 hover:underline">@Al_muhsinoon</a>
    </p>
  </div>
</section>
