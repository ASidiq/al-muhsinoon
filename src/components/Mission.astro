---
import StarDivider from './StarDivider.astro';

const pillars = [
  {
    label: 'Worship',
    body: 'A clean, welcoming prayer hall open for all five daily prayers and Friday congregation, for residents and visitors alike.',
  },
  {
    label: 'Learning',
    body: 'Qur’an recitation, tajweed and Arabic, taught from first letters through to fluency, for children and adults.',
  },
  {
    label: 'Service',
    body: 'Zakat and sadaqah collected and distributed locally — food, hardship grants, and a hand extended to anyone in need.',
  },
];
---

<section id="mission" class="bg-maroon py-20 text-cream sm:py-28">
  <div class="mx-auto max-w-4xl px-6 text-center sm:px-8">
    <p class="font-arabic text-[2.4rem] leading-[1.5] text-sand sm:text-[2.9rem]" dir="rtl">
      وَأَحْسِنُوا ۛ إِنَّ اللَّهَ يُحِبُّ الْمُحْسِنِينَ
    </p>
    <p class="mx-auto mt-5 max-w-xl font-display text-[19px] italic leading-[1.7] text-cream/85 sm:text-[21px]">
      “…and do good: truly Allah loves <span class="text-gold">al-muhsinin</span> — the doers of good.”
    </p>
    <p class="mt-2 font-body text-[12.5px] font-semibold uppercase tracking-[0.18em] text-cream/45">Qur’an 2:195</p>

    <StarDivider class="my-10 opacity-70" />

    <h2 class="font-display text-[1.9rem] font-medium leading-tight text-cream sm:text-[2.3rem]">
      Our mission takes its name from this verse.
    </h2>
    <p class="mx-auto mt-4 max-w-xl font-body text-[16px] leading-[1.75] text-cream/70">
      We exist to make ihsan practical: a place to pray with sincerity, learn with purpose, and serve the people of Manchester without condition.
    </p>
  </div>

  <div class="mx-auto mt-16 grid max-w-5xl grid-cols-1 gap-px overflow-hidden rounded-lg bg-cream/15 sm:grid-cols-3 sm:px-8">
    {pillars.map((pillar) => (
      <div class="bg-maroon-dark/40 px-8 py-10 text-left">
        <h3 class="font-display text-[20px] font-medium text-gold">{pillar.label}</h3>
        <p class="mt-3 font-body text-[14.5px] leading-[1.7] text-cream/70">{pillar.body}</p>
      </div>
    ))}
  </div>
</section>
